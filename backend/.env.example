# MediKiosk Environment Configuration Template
# Copy to .env for local development. NEVER COMMIT .env TO VERSION CONTROL.

# Application Configuration
APP_NAME=MediKiosk
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=dev-insecure-jwt-signing-secret-change-in-production-min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# AI4Bharat & Bhashini Speech Pipeline Credentials
AI4BHARAT_API_KEY=your_ai4bharat_api_key_here
AI4BHARAT_ASR_URL=https://models.ai4bharat.org/inference/asr
AI4BHARAT_TTS_URL=https://models.ai4bharat.org/inference/tts
BHASHINI_USER_ID=demo_bhashini_user
BHASHINI_API_KEY=demo_bhashini_api_key_2026
BHASHINI_PIPELINE_ID=demo_pipeline_id

# Database Credentials
POSTGRES_USER=medikiosk_admin
POSTGRES_PASSWORD=medikiosk_secure_dev_password_2026
POSTGRES_DB=medikiosk_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://medikiosk_admin:medikiosk_secure_dev_password_2026@localhost:5432/medikiosk_db

# Redis Cache & Sliding Window Limiter
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=medikiosk_redis_secure_pass_2026
REDIS_URL=redis://:medikiosk_redis_secure_pass_2026@localhost:6379/0

# KMS Data Encryption Key (Fernet 32-byte urlsafe base64)
KMS_DATA_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=

# Blind Search Index HMAC Secret Pepper (Min 32 characters)
BLIND_INDEX_PEPPER=hospital_scoped_dev_hmac_secret_pepper_2026_salt_xyz

# QR Code Cryptographic Anti-Tamper Secret
QR_SIGNING_SECRET=qr_tamper_evident_signing_secret_key_2026_xyz

# ABDM Gateway Mock / Sandbox Credentials
ABDM_CLIENT_ID=demo_abdm_client_id
ABDM_CLIENT_SECRET=demo_abdm_client_secret
ABDM_BASE_URL=https://dev.abdm.gov.in/gateway
